{
  "name": "p3p-client-sdk",
  "version": "1.1.0",
  "description": "Pine Labs Online P3P Client SDK - Pine Labs Online P3P client for AI agents (TypeScript)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/plural-pinelabs/mpp-client-sdk-typescript"
  },
  "keywords": [
    "p3p",
    "x402",
    "payment",
    "client",
    "pinelabs",
    "upi",
    "reserve-pay",
    "pinelabs-payment-protocol"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "require": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    },
    "./grantex": {
      "types": "./dist/grantex/index.d.ts",
      "require": "./dist/grantex/index.js",
      "default": "./dist/grantex/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "require": "./dist/config/index.js",
      "default": "./dist/config/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "require": "./dist/types/index.js",
      "default": "./dist/types/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "require": "./dist/utils/index.js",
      "default": "./dist/utils/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@grantex/sdk": "0.3.8"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^5.7.0"
  }
}
